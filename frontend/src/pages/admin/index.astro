        if ((activeAccessTab === 'users' && !canUsers) || (activeAccessTab === 'groups' && !canGroups)) activeAccessTab = canUsers ? 'users' : 'groups';
        const usersTab = $('#users-tab'); const groupsTab = $('#groups-tab');
        const addGroup = $('#create-group-button');
        const addUser = $('#create-user-button');
