        en: { adminAccess:'ADMIN',loginTitle:'Sign in to your workspace',username:'Username',password:'Password',signIn:'Sign in',backToSite:'Back to site',workspace:'WORKSPACE',overview:'Overview',captions:'Captions',newCaption:'New caption',publishing:'Caption publishing',viewSite:'View site',workspaceTitle:'Caption workspace',dashboardHint:'Review drafts and keep captions up to date.',needsAttention:'Needs attention',unpublishedCaptions:'unpublished captions',viewDrafts:'View drafts',recentCaptions:'Recently updated',latestChanges:'Latest caption changes',allCaptions:'All captions',content:'CONTENT',listHint:'Search, filter, and update captions shown on your site.',allCategories:'All categories',allStatuses:'All statuses',published:'Published',draft:'Draft',allFeatured:'Featured: all',featured:'Featured',standard:'Standard',columns:'Columns',selected:'selected',bulkChoose:'Choose an action',publish:'Publish',makeDraft:'Move to drafts',feature:'Feature',unfeature:'Remove featured',delete:'Delete',apply:'Apply',captionEditor:'CAPTION EDITOR',captionText:'Caption',category:'Category',author:'Author name',cancel:'Cancel',save:'Save caption',deleteCaption:'DELETE CAPTION',confirmDelete:'Confirm deletion',globalSearch:'Search captions and pages',listSearch:'Search captions, categories, or authors',commandSearch:'Search captions or go to a page',allCaughtUp:'All caught up',noDrafts:'There are no unpublished captions.',noCaptions:'No captions yet',firstCaption:'Add a caption to publish it on your site.',updated:'Updated',likes:'Likes',status:'Status',featuredColumn:'Featured',created:'Created',search:'Search',pageOf:'Page',noResults:'No captions match this search.',saveOk:'Caption saved.',deleteOk:'Caption deleted.',bulkOk:'Selected captions updated.',loadError:'Could not load captions. Try again.' }
      };
      let language = localStorage.getItem('caption-admin-language') || 'bn';
      let csrfToken = '';
      let permissions = { add: false, change: false, delete: false };
      let activeView = 'overview';
      let activeAccessTab = 'users';
      let accessData = { users: [], groups: [], can_view_users: false, can_view_groups: false };
      let captions = [];
      let categories = [];
      let currentPage = 1;
      let totalPages = 1;
      let ordering = '-created_at';
      let pendingDelete = null;
      let searchTimer;
      let keyboardPrefix = '';
      let toastTimer;
      const $ = (selector) => document.querySelector(selector);
      const $$ = (selector) => [...document.querySelectorAll(selector)];
      const text = (key) => uiText[language][key] || key;
      const esc = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' })[char]);
      const icon = (name, cls = 'icon size-4') => `<svg class="${cls}" aria-hidden="true"><use href="#icon-${name}"></use></svg>`;
      async function request(path, options = {}) {
        const headers = new Headers(options.headers || {});
        if (options.body) headers.set('Content-Type', 'application/json');
        if (csrfToken && options.method && !['GET','HEAD','OPTIONS'].includes(options.method)) headers.set('X-CSRFToken', csrfToken);
        const response = await fetch(`${API}${path}`, { credentials:'include', ...options, headers });
        let payload = {};
        try { payload = await response.json(); } catch {}
        if (!response.ok) {
          const error = new Error(payload.error || Object.values(payload.errors || {})[0] || `Request failed (${response.status})`);
          error.status = response.status; error.payload = payload; throw error;
        }
        return payload;
      }
      function notify(message, tone = 'success') {
        const toast = $('#toast'); toast.textContent = message; toast.dataset.tone = tone; toast.classList.remove('hidden');
        clearTimeout(toastTimer); toastTimer = setTimeout(() => toast.classList.add('hidden'), 3200);
      }
      function setLanguage(value) {
        language = value === 'en' ? 'en' : 'bn'; localStorage.setItem('caption-admin-language', language);
        document.documentElement.lang = language; $('#language-select').value = language;
        $$('[data-t]').forEach((node) => { const key = node.dataset.t; if (uiText[language][key]) node.textContent = text(key); });
        $$('[data-placeholder]').forEach((node) => { node.placeholder = text(node.dataset.placeholder); });
        $('#caption-search').placeholder = text('listSearch');
        document.title = `${text('workspaceTitle')} | কথার ঘর`;
        if (!$('#admin-app').classList.contains('hidden')) { if (activeView === 'access') renderAccess(); else if (activeView === 'captions') loadCaptions(); else renderDashboard(); }
      }
      function showLogin() { $('#admin-app').classList.add('hidden'); $('#login-screen').classList.remove('hidden'); }
      function showApp() { $('#login-screen').classList.add('hidden'); $('#admin-app').classList.remove('hidden'); $('#user-name').textContent = $('#user-name').dataset.username || ''; }
      function setView(view) {
        if (view === 'access' && !permissions.view_users && !permissions.view_groups) view = 'overview';
        activeView = view;
        $$('[data-view]').forEach((section) => section.classList.toggle('hidden', section.dataset.view !== view));
        $$('[data-view-link]').forEach((button) => {
          const active = button.dataset.viewLink === view;
          button.classList.toggle('bg-surface-brand', active); button.classList.toggle('font-semibold', active); button.classList.toggle('text-brand', active);
          button.classList.toggle('text-muted', !active);
        });
        history.replaceState(null, '', view === 'captions' || view === 'access' ? `/admin/?view=${view}` : '/admin/');
        if (view === 'captions') loadCaptions(); else if (view === 'access') loadAccess(); else renderDashboard();
        closeSidebar();
