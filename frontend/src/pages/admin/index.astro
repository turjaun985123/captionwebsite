          $('#draft-list').innerHTML = drafts.length ? drafts.map((item) => `<div class="flex items-center gap-3 border-b border-border px-4 py-3 last:border-0"><span class="size-2 shrink-0 rounded-full bg-accent"></span><div class="min-w-0 flex-1"><button data-edit-id="${item.id}" class="block max-w-full truncate text-left text-sm font-medium hover:text-brand">${esc(item.text)}</button><span class="text-xs text-muted">${esc(item.category)} · ${esc(text('draft'))}</span></div><button data-edit-id="${item.id}" class="grid size-8 place-items-center rounded text-muted hover:bg-surface-muted" aria-label="Edit caption">${icon('arrow')}</button></div>`).join('') : `<div class="flex items-center gap-3 px-4 py-4"><span class="grid size-8 place-items-center rounded-full bg-surface-brand text-brand">${icon('check')}</span><div><strong class="text-sm">${esc(text('allCaughtUp'))}</strong><p class="text-xs text-muted">${esc(text('noDrafts'))}</p></div></div>`;
          $('#recent-list').innerHTML = `<table class="admin-table text-left text-sm"><thead class="bg-surface-muted text-[11px] font-semibold uppercase tracking-wide text-muted"><tr><th class="px-3 py-3">${esc(text('captionText'))}</th><th class="px-3 py-3">${esc(text('category'))}</th><th class="px-3 py-3">${esc(text('status'))}</th><th class="px-3 py-3">${esc(text('updated'))}</th><th></th></tr></thead><tbody>${tableMarkup(data.results, true).replace(/^.*?<tbody>/s, '').replace(/<\/tbody><\/table>$/s, '')}</tbody></table>`;
        } catch (error) { $('#draft-list').innerHTML = `<p class="p-4 text-sm text-accent">${esc(error.message || text('loadError'))}</p>`; }
      }
      function openEditor(item = null) {
        $('#caption-form').reset(); $('#form-error').classList.add('hidden'); $$('.field-error').forEach((node) => node.classList.add('hidden'));
        $('#caption-id').value = item?.id || ''; $('#caption-text').value = item?.text || ''; $('#caption-category').value = item?.category || categories[0] || 'অনুভূতি'; $('#caption-author').value = item?.author || '';
        $('#caption-published').checked = item ? item.is_published : true; $('#caption-featured').checked = item ? item.is_featured : false;
        $('#char-count').textContent = String($('#caption-text').value.length); $('#dialog-title').textContent = item ? (language === 'bn' ? 'ক্যাপশন সম্পাদনা' : 'Edit caption') : text('newCaption');
        $('#caption-dialog').showModal(); $('#caption-text').focus();
      }
      function updateBulkBar() {
        const selected = $$('.row-check:checked'); $('#selected-count').textContent = String(selected.length);
        $('#bulk-bar').classList.toggle('hidden', !selected.length); $('#bulk-bar').classList.toggle('flex', !!selected.length);
      }
      function showDelete(itemIds) {
        pendingDelete = itemIds;
        const names = itemIds.map((id) => captions.find((item) => item.id === id)?.text).filter(Boolean);
        $('#delete-description').textContent = itemIds.length === 1 ? (language === 'bn' ? `“${names[0]}” মুছে যাবে। এই কাজটি ফিরিয়ে নেওয়া যাবে না।` : `“${names[0]}” will be deleted. This cannot be undone.`) : (language === 'bn' ? `${itemIds.length}টি নির্বাচিত ক্যাপশন মুছে যাবে। এই কাজটি ফিরিয়ে নেওয়া যাবে না।` : `${itemIds.length} selected captions will be deleted. This cannot be undone.`);
        $('#delete-dialog').showModal();
      }
      async function saveCaption(event) {
        event.preventDefault();
        $$('.field-error').forEach((node) => node.classList.add('hidden')); $('#form-error').classList.add('hidden');
        const id = $('#caption-id').value;
        const body = { text:$('#caption-text').value, category:$('#caption-category').value, author:$('#caption-author').value, is_published:$('#caption-published').checked, is_featured:$('#caption-featured').checked };
        if (!body.text.trim()) { const field=$('[data-error="text"]'); field.textContent=language==='bn'?'ক্যাপশন লিখুন।':'Caption text is required.'; field.classList.remove('hidden'); $('#caption-text').focus(); return; }
        $('#save-caption').disabled = true;
        try { await request(id ? `/admin/captions/${id}/` : '/admin/captions/', { method:id?'PATCH':'POST', body:JSON.stringify(body) }); $('#caption-dialog').close(); notify(text('saveOk')); currentPage=1; await loadCaptions(); await renderDashboard(); }
        catch (error) { const errors=error.payload?.errors; if (errors) Object.entries(errors).forEach(([key,value])=>{const field=$(`[data-error="${key}"]`);if(field){field.textContent=value;field.classList.remove('hidden')}}); else { $('#form-error').textContent=error.message; $('#form-error').classList.remove('hidden');} }
        finally { $('#save-caption').disabled = false; }
      }
      async function deleteConfirmed() {
        if (!pendingDelete) return;
        const ids = pendingDelete; $('#confirm-delete').disabled = true;
        try {
          if (ids.length === 1) await request(`/admin/captions/${ids[0]}/`, { method:'DELETE' });
          else await request('/admin/captions/bulk/', { method:'POST', body:JSON.stringify({ action:'delete', ids }) });
          $('#delete-dialog').close(); notify(text('deleteOk')); pendingDelete=null; await loadCaptions(); await renderDashboard();
        } catch (error) { notify(error.message, 'error'); }
        finally { $('#confirm-delete').disabled = false; }
      }
      async function runBulk() {
        const ids = $$('.row-check:checked').map((node) => Number(node.value)); const action=$('#bulk-action').value;
        if (!ids.length || !action) { notify(language==='bn'?'ক্যাপশন ও কাজ বেছে নিন।':'Choose captions and an action.', 'error'); return; }
        if (action === 'delete') { showDelete(ids); return; }
        try { await request('/admin/captions/bulk/', { method:'POST', body:JSON.stringify({action,ids}) }); notify(text('bulkOk')); await loadCaptions(); await renderDashboard(); }
        catch (error) { notify(error.message, 'error'); }
      }
      async function initialize() {
        setLanguage(language);
        try {
          const session = await request('/admin/session/'); csrfToken=session.csrfToken; permissions=session.permissions;
          if (session.authenticated) { $('#user-name').dataset.username=session.username; showApp(); $('#access-label').classList.toggle('hidden', !permissions.view_users && !permissions.view_groups); $('#access-nav').classList.toggle('hidden', !permissions.view_users && !permissions.view_groups); if (!permissions.add) $$('.primary-action').forEach((node)=>node.remove()); if (!permissions.change) $('#bulk-action').querySelectorAll('option:not([value=""]):not([value="delete"])').forEach((o)=>o.remove()); if (!permissions.delete) $('#bulk-action').querySelector('option[value="delete"]').remove(); const requestedView=new URLSearchParams(location.search).get('view'); const view=requestedView==='captions'?'captions':requestedView==='access'?'access':'overview';setView(view); }
          else showLogin();
        } catch { $('#login-error').textContent=text('loadError'); $('#login-error').classList.remove('hidden'); showLogin(); }
      }

      $('#login-form').addEventListener('submit', async (event) => {
        event.preventDefault(); $('#login-error').classList.add('hidden'); const button=$('#login-submit');button.disabled=true;
        try { const data=await request('/admin/login/',{method:'POST',body:JSON.stringify({username:$('#username').value,password:$('#password').value})});csrfToken=data.csrfToken;$('#user-name').dataset.username=data.username;const session=await request('/admin/session/');csrfToken=session.csrfToken;permissions=session.permissions;showApp();setView('overview'); }
        catch(error){$('#login-error').textContent=error.message;$('#login-error').classList.remove('hidden');}
        finally{button.disabled=false;}
      });
      $('#logout-button').addEventListener('click',async()=>{try{await request('/admin/logout/',{method:'POST'});}catch{}showLogin();});
      $('#language-select').addEventListener('change',(event)=>setLanguage(event.target.value));
      $$('[data-view-link]').forEach((button)=>button.addEventListener('click',()=>setView(button.dataset.viewLink)));
      $$('[data-access-tab]').forEach((button)=>button.addEventListener('click',()=>{activeAccessTab=button.dataset.accessTab;renderAccess();}));
      $('#access-search').addEventListener('input',()=>{clearTimeout(searchTimer);searchTimer=setTimeout(loadAccess,180);});
      $('#sidebar-add').addEventListener('click',()=>openEditor());
      $$('[data-new-caption]').forEach((button)=>button.addEventListener('click',()=>openEditor()));
      $('#view-all').addEventListener('click',()=>setView('captions'));
      $('#view-drafts').addEventListener('click',()=>{setView('captions');$('#status-filter').value='draft';currentPage=1;loadCaptions();});
      $('#caption-search').addEventListener('input',()=>{clearTimeout(searchTimer);searchTimer=setTimeout(()=>{currentPage=1;loadCaptions();},180);});
      ['#category-filter','#status-filter','#featured-filter'].forEach((selector)=>$(selector).addEventListener('change',()=>{currentPage=1;loadCaptions();}));
      $('#previous-page').addEventListener('click',()=>{if(currentPage>1){currentPage--;loadCaptions();}});
      $('#next-page').addEventListener('click',()=>{if(currentPage<totalPages){currentPage++;loadCaptions();}});
      $('#caption-table').addEventListener('change',(event)=>{if(event.target.matches('.row-check'))updateBulkBar();if(event.target.id==='select-all'){$$('.row-check').forEach((checkbox)=>checkbox.checked=event.target.checked);updateBulkBar();}});
      $('#caption-table').addEventListener('click',(event)=>{const sort=event.target.closest('[data-sort]');const edit=event.target.closest('[data-edit-id]');const del=event.target.closest('[data-delete-id]');if(sort){const field=sort.dataset.sort;ordering=ordering===field?`-${field}`:field;currentPage=1;loadCaptions();return;}if(edit){event.preventDefault();const item=captions.find((entry)=>entry.id===Number(edit.dataset.editId));if(item)openEditor(item);}if(del)showDelete([Number(del.dataset.deleteId)]);});
      $('#run-bulk').addEventListener('click',runBulk);
      $('#create-group-button').addEventListener('click',openGroupDialog);
      $('#group-form').addEventListener('submit',saveGroup);
      $('#cancel-group').addEventListener('click',()=>$('#group-dialog').close());
      $('#close-group-dialog').addEventListener('click',()=>$('#group-dialog').close());
      $('#create-user-button').addEventListener('click',openUserDialog);
      $('#user-form').addEventListener('submit',saveUser);
      $('#cancel-user').addEventListener('click',()=>$('#user-dialog').close());
      $('#close-user-dialog').addEventListener('click',()=>$('#user-dialog').close());
      $('#access-list').addEventListener('click',(event)=>{const button=event.target.closest('[data-password-user]');if(button)openPasswordDialog(Number(button.dataset.passwordUser));});
      $('#password-form').addEventListener('submit',savePassword);
      $('#cancel-password').addEventListener('click',()=>$('#password-dialog').close());
      $('#close-password-dialog').addEventListener('click',()=>$('#password-dialog').close());
      $('#caption-form').addEventListener('submit',saveCaption);
      $('#caption-text').addEventListener('input',()=>$('#char-count').textContent=String($('#caption-text').value.length));
      $$('[data-close-dialog]').forEach((button)=>button.addEventListener('click',()=>$('#caption-dialog').close()));
      $('#cancel-delete').addEventListener('click',()=>$('#delete-dialog').close());$('#confirm-delete').addEventListener('click',deleteConfirmed);
      $('#menu-button').addEventListener('click',openSidebar);$('#mobile-backdrop').addEventListener('click',closeSidebar);
      $('#global-search').addEventListener('focus',()=>{setView('captions');$('#caption-search').value=$('#global-search').value;$('#caption-search').focus();});
      $('#global-search').addEventListener('input',()=>{if(!$('#captions-view').classList.contains('hidden')){$('#caption-search').value=$('#global-search').value;$('#caption-search').dispatchEvent(new Event('input'));}});
      $('#column-button').addEventListener('click',()=>$('#column-menu').classList.toggle('hidden'));
      document.addEventListener('click',(event)=>{if(event.target.closest('#column-button'))return;if(!event.target.closest('#column-menu'))$('#column-menu').classList.add('hidden');});
      function buildColumnMenu(){const menu=$('#column-menu');menu.innerHTML=[['category','category'],['likes','likes'],['featuredColumn','featuredColumn'],['status','status'],['created','created']].map(([key,label])=>`<label class="flex cursor-pointer items-center gap-2 px-2 py-1.5 text-xs"><input type="checkbox" checked data-column="${key}" class="accent-brand"><span>${esc(text(label))}</span></label>`).join('');menu.querySelectorAll('[data-column]').forEach((checkbox)=>checkbox.addEventListener('change',()=>{const index={category:2,likes:3,featuredColumn:4,status:5,created:6}[checkbox.dataset.column];$$(`#caption-table tr > :nth-child(${index+1})`).forEach((cell)=>cell.classList.toggle('hidden',!checkbox.checked));}));}
      $('#column-button').addEventListener('click',buildColumnMenu);
      $('#command-search').addEventListener('input',()=>{const q=$('#command-search').value.trim().toLowerCase();$$('[data-command]').forEach((button)=>button.classList.toggle('hidden',q&&!button.textContent.toLowerCase().includes(q)));});
      $('#command-search').addEventListener('keydown',(event)=>{if(event.key==='Enter'){event.preventDefault();const q=$('#command-search').value.trim();$('#command-dialog').close();if(q){setView('captions');$('#caption-search').value=q;loadCaptions();}else $$('[data-command]:not(.hidden)')[0]?.click();}});
      $('#close-command').addEventListener('click',()=>$('#command-dialog').close());
      $$('[data-command]').forEach((button)=>button.addEventListener('click',()=>{const action=button.dataset.command;$('#command-dialog').close();if(action==='new')openEditor();else setView(action);}));
      document.addEventListener('keydown',(event)=>{if((event.metaKey||event.ctrlKey)&&event.key.toLowerCase()==='k'){event.preventDefault();$('#command-dialog').showModal();$('#command-search').focus();}if(event.target.matches('input,textarea,select,[contenteditable="true"]')||event.metaKey||event.ctrlKey)return;const key=event.key.toLowerCase();if(key==='n'&&permissions.add)openEditor();if(keyboardPrefix==='g'&&key==='o')setView('overview');if(keyboardPrefix==='g'&&key==='c')setView('captions');keyboardPrefix=key==='g'?'g':'';});
      initialize();
    </script>
  </body>
</html>
