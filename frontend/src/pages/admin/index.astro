---
import '../../styles/admin.css';
const apiBase = (import.meta.env.PUBLIC_API_URL || 'http://localhost:8000/api').replace(/\/$/, '');
---

<!doctype html>
<html lang="bn" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f5ed" />
    <title>ক্যাপশন ওয়ার্কস্পেস | কথার ঘর</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Noto+Serif+Bengali:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-canvas text-ink antialiased">
    <svg class="screen-reader-only" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
      <symbol id="icon-pen" viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z"/></symbol>
      <symbol id="icon-menu" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></symbol>
      <symbol id="icon-dashboard" viewBox="0 0 24 24"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></symbol>
      <symbol id="icon-files" viewBox="0 0 24 24"><path d="M15 2H6a2 2 0 0 0-2 2v14"/><path d="M18 8H10a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-10a2 2 0 0 0-2-2Z"/><path d="M8 6h10"/></symbol>
      <symbol id="icon-users" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="10" cy="7" r="4"/><path d="M20 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></symbol>
      <symbol id="icon-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></symbol>
      <symbol id="icon-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
      <symbol id="icon-arrow" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></symbol>
      <symbol id="icon-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></symbol>
      <symbol id="icon-filter" viewBox="0 0 24 24"><path d="M4 6h16M7 12h10m-7 6h4"/></symbol>
      <symbol id="icon-edit" viewBox="0 0 24 24"><path d="m16 4 4 4M4 20l4-.8L19 8a2.1 2.1 0 0 0-3-3L5 16z"/></symbol>
      <symbol id="icon-trash" viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2m3 0-1 14H6L5 6m4 4v6m6-6v6"/></symbol>
      <symbol id="icon-chevron" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></symbol>
      <symbol id="icon-logout" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4m7 14 5-5-5-5m5 5H9"/></symbol>
      <symbol id="icon-close" viewBox="0 0 24 24"><path d="m18 6-12 12M6 6l12 12"/></symbol>
      <symbol id="icon-copy" viewBox="0 0 24 24"><rect x="8" y="8" width="13" height="13" rx="2"/><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"/></symbol>
      <symbol id="icon-lock" viewBox="0 0 24 24"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4m-4 4v2"/></symbol>
    </svg>

    <main id="login-screen" class="mx-auto flex min-h-screen max-w-md items-center px-5 py-10">
      <section class="w-full rounded-xl border border-border bg-surface p-7 shadow-sm sm:p-9" aria-labelledby="login-title">
        <div class="mb-7 flex items-center gap-3">
          <span class="grid size-11 place-items-center rounded-lg bg-surface-brand text-brand"><svg class="icon"><use href="#icon-pen" /></svg></span>
          <div><strong class="block font-display text-lg">কথার ঘর</strong><span class="text-xs font-semibold tracking-widest text-muted">CONTENT STUDIO</span></div>
        </div>
        <p class="mb-1 text-xs font-semibold tracking-widest text-muted" data-t="adminAccess">অ্যাডমিন</p>
        <h1 id="login-title" class="mb-6 font-display text-2xl font-semibold" data-t="loginTitle">ওয়ার্কস্পেসে প্রবেশ</h1>
        <form id="login-form" class="space-y-4">
          <label class="block text-sm font-medium"><span data-t="username">সদস্যনাম</span><input id="username" name="username" autocomplete="username" required class="mt-1.5 min-h-11 w-full rounded-md border border-border bg-canvas px-3 text-sm outline-none focus:border-brand" /></label>
          <label class="block text-sm font-medium"><span data-t="password">পাসওয়ার্ড</span><input id="password" name="password" type="password" autocomplete="current-password" required class="mt-1.5 min-h-11 w-full rounded-md border border-border bg-canvas px-3 text-sm outline-none focus:border-brand" /></label>
          <p id="login-error" class="hidden rounded-md border border-accent/30 bg-accent/5 px-3 py-2 text-sm text-accent" role="alert"></p>
          <button id="login-submit" class="inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-md bg-brand px-4 text-sm font-semibold text-white transition-colors hover:bg-brand-strong disabled:opacity-60"><span data-t="signIn">প্রবেশ করুন</span><svg class="icon"><use href="#icon-arrow" /></svg></button>
        </form>
        <a href="/" class="mt-5 inline-flex items-center gap-2 text-sm text-muted hover:text-brand"><svg class="icon size-4"><use href="#icon-chevron" /></svg><span data-t="backToSite">সাইটে ফিরুন</span></a>
      </section>
    </main>

    <div id="admin-app" class="admin-frame hidden flex min-h-screen">
      <button id="mobile-backdrop" class="mobile-backdrop fixed inset-0 z-20 hidden bg-ink/30 md:hidden" data-open="false" aria-label="Close navigation"></button>
      <aside id="admin-sidebar" class="admin-sidebar fixed inset-y-0 left-0 z-30 flex flex-col border-r border-border bg-surface px-3 py-4 md:sticky md:top-0 md:h-screen md:translate-x-0">
        <a href="/admin/" class="mb-5 flex items-center gap-3 border-b border-border px-2 pb-5 text-ink">
          <span class="grid size-9 place-items-center rounded-md bg-surface-brand text-brand"><svg class="icon"><use href="#icon-pen" /></svg></span>
          <span><strong class="block font-display text-base">কথার ঘর</strong><small class="text-[10px] font-semibold tracking-widest text-muted">CONTENT STUDIO</small></span>
        </a>
        <p class="mb-2 px-2 text-[10px] font-semibold tracking-widest text-muted" data-t="workspace">কাজের জায়গা</p>
        <nav class="space-y-1" aria-label="Admin navigation">
          <button data-view-link="overview" class="nav-link flex min-h-10 w-full items-center gap-3 rounded-md px-3 text-left text-sm text-muted hover:bg-surface-muted"><svg class="icon size-[17px]"><use href="#icon-dashboard" /></svg><span data-t="overview">ওভারভিউ</span></button>
          <button data-view-link="captions" class="nav-link flex min-h-10 w-full items-center gap-3 rounded-md px-3 text-left text-sm text-muted hover:bg-surface-muted"><svg class="icon size-[17px]"><use href="#icon-files" /></svg><span data-t="captions">ক্যাপশনসমূহ</span><span id="caption-count" class="ml-auto text-xs text-muted"></span></button>
        </nav>
        <p id="access-label" class="mb-2 mt-5 px-2 text-[10px] font-semibold tracking-widest text-muted">প্রবেশাধিকার</p>
        <button id="access-nav" data-view-link="access" class="nav-link flex min-h-10 w-full items-center gap-3 rounded-md px-3 text-left text-sm text-muted hover:bg-surface-muted"><svg class="icon size-[17px]"><use href="#icon-users" /></svg><span id="access-nav-text">সদস্য ও দল</span></button>
        <button id="sidebar-add" class="mt-5 inline-flex min-h-10 items-center gap-2 rounded-md border border-border px-3 text-sm font-semibold text-brand hover:border-brand hover:bg-surface-brand"><svg class="icon size-4"><use href="#icon-plus" /></svg><span data-t="newCaption">নতুন ক্যাপশন</span></button>
        <div class="mt-auto border-t border-border pt-4">
          <div class="flex items-center justify-between gap-2 px-1">
            <span class="inline-flex items-center gap-2 text-xs text-muted"><span class="size-2 rounded-full bg-brand"></span><span data-t="publishing">ক্যাপশন প্রকাশনা</span></span>
            <a href="/" target="_blank" rel="noreferrer" class="rounded px-2 py-1 text-xs font-medium text-brand hover:bg-surface-brand" data-t="viewSite">সাইট দেখুন</a>
          </div>
        </div>
      </aside>

      <section class="admin-content min-h-screen flex-1">
        <header class="sticky top-0 z-10 flex min-h-[62px] items-center gap-3 border-b border-border bg-canvas/95 px-4 backdrop-blur-sm sm:px-6 lg:px-9">
          <button id="menu-button" class="grid size-10 shrink-0 place-items-center rounded-md border border-border bg-surface text-muted md:hidden" aria-label="Open navigation"><svg class="icon"><use href="#icon-menu" /></svg></button>
          <div class="hidden text-xs font-semibold tracking-widest text-muted sm:block">CONTENT STUDIO</div>
          <label class="ml-auto flex h-9 min-w-0 flex-1 items-center gap-2 rounded-md border border-border bg-surface px-2.5 text-muted focus-within:border-brand sm:max-w-sm"><svg class="icon size-4"><use href="#icon-search" /></svg><input id="global-search" type="search" class="min-w-0 flex-1 bg-transparent text-sm text-ink outline-none" placeholder="ক্যাপশন ও পেজ খুঁজুন" data-placeholder="globalSearch" aria-label="Global search" /><kbd class="rounded border border-border bg-surface-muted px-1.5 py-0.5 text-[10px]">Ctrl K</kbd></label>
          <select id="language-select" class="h-9 rounded-md border border-border bg-surface px-2 text-xs text-ink" aria-label="Language"><option value="bn">বাংলা</option><option value="en">English</option></select>
          <span id="user-name" class="hidden max-w-24 truncate text-xs text-muted lg:block"></span>
          <button id="logout-button" class="grid size-9 shrink-0 place-items-center rounded-md text-muted hover:bg-surface-muted hover:text-ink" aria-label="Log out" title="Log out"><svg class="icon size-4"><use href="#icon-logout" /></svg></button>
        </header>

        <div class="px-3 py-5 sm:px-6 lg:px-9">
          <section id="overview-view" data-view="overview" class="view-pane">
            <div class="mb-7 flex flex-wrap items-end justify-between gap-4">
              <div><p class="mb-1 text-xs font-semibold tracking-widest text-muted" data-t="overview">ওভারভিউ</p><h1 class="font-display text-2xl font-semibold sm:text-3xl" data-t="workspaceTitle">ক্যাপশন ওয়ার্কস্পেস</h1><p class="mt-1 text-sm text-muted" data-t="dashboardHint">খসড়া দেখুন, ক্যাপশন হালনাগাদ রাখুন।</p></div>
              <button data-new-caption class="primary-action inline-flex min-h-10 items-center gap-2 rounded-md bg-brand px-3.5 text-sm font-semibold text-white hover:bg-brand-strong"><svg class="icon size-4"><use href="#icon-plus" /></svg><span data-t="newCaption">নতুন ক্যাপশন</span></button>
            </div>
            <section class="mb-8" aria-labelledby="draft-heading">
              <div class="mb-3 flex flex-wrap items-center justify-between gap-3"><div><h2 id="draft-heading" class="font-display text-lg font-semibold" data-t="needsAttention">যা দেখার বাকি</h2><p class="text-xs text-muted"><span id="draft-count">0</span> <span data-t="unpublishedCaptions">অপ্রকাশিত ক্যাপশন</span></p></div><button id="view-drafts" class="inline-flex items-center gap-1 text-sm font-semibold text-brand hover:text-brand-strong"><span data-t="viewDrafts">খসড়া দেখুন</span><svg class="icon size-4"><use href="#icon-arrow" /></svg></button></div>
              <div id="draft-list" class="overflow-hidden rounded-lg border border-border bg-surface"></div>
            </section>
            <section aria-labelledby="recent-heading">
              <div class="mb-3 flex items-end justify-between gap-3"><div><h2 id="recent-heading" class="font-display text-lg font-semibold" data-t="recentCaptions">সাম্প্রতিক ক্যাপশন</h2><p class="text-xs text-muted" data-t="latestChanges">সর্বশেষ সম্পাদনা</p></div><button id="view-all" class="inline-flex items-center gap-1 text-sm font-semibold text-brand"><span data-t="allCaptions">সব ক্যাপশন</span><svg class="icon size-4"><use href="#icon-arrow" /></svg></button></div>
              <div id="recent-list" class="admin-table-scroll rounded-lg border border-border bg-surface"></div>
            </section>
          </section>

          <section id="captions-view" data-view="captions" class="view-pane hidden">
            <div class="mb-5 flex flex-wrap items-end justify-between gap-4"><div><p class="mb-1 text-xs font-semibold tracking-widest text-muted" data-t="content">কনটেন্ট</p><h1 class="font-display text-2xl font-semibold sm:text-3xl" data-t="allCaptions">সব ক্যাপশন</h1><p class="mt-1 text-sm text-muted" data-t="listHint">ক্যাপশন খুঁজুন, বাছাই করুন ও হালনাগাদ করুন।</p></div><button data-new-caption class="primary-action inline-flex min-h-10 items-center gap-2 rounded-md bg-brand px-3.5 text-sm font-semibold text-white hover:bg-brand-strong"><svg class="icon size-4"><use href="#icon-plus" /></svg><span data-t="newCaption">নতুন ক্যাপশন</span></button></div>
            <div class="mb-3 flex flex-wrap items-center gap-2 rounded-lg border border-border bg-surface p-2.5">
              <label class="flex min-h-9 min-w-[220px] flex-1 items-center gap-2 rounded-md border border-border bg-canvas px-2.5 text-muted"><svg class="icon size-4"><use href="#icon-search" /></svg><input id="caption-search" type="search" class="min-w-0 flex-1 bg-transparent text-sm text-ink outline-none" placeholder="ক্যাপশন, বিষয় বা লেখক খুঁজুন" data-placeholder="listSearch" /></label>
              <select id="category-filter" class="h-9 rounded-md border border-border bg-surface px-2.5 text-sm"><option value="" data-t="allCategories">সব বিষয়</option></select>
              <select id="status-filter" class="h-9 rounded-md border border-border bg-surface px-2.5 text-sm"><option value="" data-t="allStatuses">সব অবস্থা</option><option value="published" data-t="published">প্রকাশিত</option><option value="draft" data-t="draft">খসড়া</option></select>
              <select id="featured-filter" class="h-9 rounded-md border border-border bg-surface px-2.5 text-sm"><option value="" data-t="allFeatured">বিশেষ বাছাই: সব</option><option value="yes" data-t="featured">বিশেষ</option><option value="no" data-t="standard">সাধারণ</option></select>
              <button id="column-button" class="relative inline-flex h-9 items-center gap-2 rounded-md border border-border px-2.5 text-sm text-muted hover:bg-surface-muted"><svg class="icon size-4"><use href="#icon-filter" /></svg><span data-t="columns">কলাম</span></button>
              <div id="column-menu" class="absolute z-20 mt-40 hidden w-44 rounded-md border border-border bg-surface p-2 shadow-lg"></div>
            </div>
            <div id="bulk-bar" class="mb-2 hidden flex-wrap items-center gap-2 rounded-lg border border-border bg-surface-brand px-3 py-2">
              <span class="mr-auto text-sm font-medium"><span id="selected-count">0</span> <span data-t="selected">নির্বাচিত</span></span>
              <select id="bulk-action" class="h-9 rounded-md border border-border bg-surface px-2 text-sm"><option value="" data-t="bulkChoose">নির্বাচিতদের জন্য কাজ</option><option value="publish" data-t="publish">প্রকাশ করুন</option><option value="draft" data-t="makeDraft">খসড়া করুন</option><option value="feature" data-t="feature">বিশেষ করুন</option><option value="unfeature" data-t="unfeature">বিশেষ থেকে সরান</option><option value="delete" data-t="delete">মুছে ফেলুন</option></select>
              <button id="run-bulk" class="h-9 rounded-md bg-brand px-3 text-sm font-semibold text-white hover:bg-brand-strong" data-t="apply">প্রয়োগ</button>
            </div>
            <div id="caption-table" class="admin-table-scroll rounded-lg border border-border bg-surface"></div>
            <div class="mt-3 flex items-center justify-between gap-3 rounded-lg border border-border bg-surface px-3 py-2 text-xs text-muted"><span id="list-summary">—</span><div class="flex items-center gap-2"><button id="previous-page" class="grid size-8 place-items-center rounded border border-border hover:bg-surface-muted" aria-label="Previous page"><svg class="icon size-4 rotate-180"><use href="#icon-arrow" /></svg></button><span id="page-label">1 / 1</span><button id="next-page" class="grid size-8 place-items-center rounded border border-border hover:bg-surface-muted" aria-label="Next page"><svg class="icon size-4"><use href="#icon-arrow" /></svg></button></div></div>
          </section>
          <section id="access-view" data-view="access" class="view-pane hidden">
            <div class="mb-5 flex flex-wrap items-end justify-between gap-4"><div><p class="mb-1 text-xs font-semibold tracking-widest text-muted" id="access-eyebrow">ACCESS</p><h1 class="font-display text-2xl font-semibold sm:text-3xl" id="access-title">সদস্য ও দল</h1><p class="mt-1 text-sm text-muted" id="access-hint">ব্যবহারকারীর অ্যাকাউন্ট ও দলের প্রবেশাধিকার দেখুন।</p></div></div>
            <div class="mb-4 flex flex-wrap items-center gap-2 rounded-lg border border-border bg-surface p-2.5"><div class="flex gap-1 rounded-md bg-surface-muted p-1"><button id="users-tab" class="rounded px-3 py-1.5 text-sm font-medium" data-access-tab="users">সদস্য</button><button id="groups-tab" class="rounded px-3 py-1.5 text-sm font-medium" data-access-tab="groups">দল</button></div><label class="ml-auto flex min-h-9 min-w-[180px] flex-1 items-center gap-2 rounded-md border border-border bg-canvas px-2.5 text-muted sm:max-w-sm"><svg class="icon size-4"><use href="#icon-search" /></svg><input id="access-search" type="search" class="min-w-0 flex-1 bg-transparent text-sm text-ink outline-none" placeholder="সদস্য বা দল খুঁজুন" /><span id="access-count" class="whitespace-nowrap text-xs text-muted"></span></label><button id="create-user-button" class="hidden min-h-9 shrink-0 items-center gap-2 rounded-md bg-brand px-3 text-sm font-semibold text-white hover:bg-brand-strong"><svg class="icon size-4"><use href="#icon-plus" /></svg><span id="create-user-label">নতুন সদস্য</span></button><button id="create-group-button" class="hidden min-h-9 shrink-0 items-center gap-2 rounded-md bg-brand px-3 text-sm font-semibold text-white hover:bg-brand-strong"><svg class="icon size-4"><use href="#icon-plus" /></svg><span id="create-group-label">নতুন দল</span></button></div>
            <div id="access-list" class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3"></div>
          </section>
        </div>
      </section>
    </div>

    <dialog id="caption-dialog" class="confirm-dialog p-0">
      <form id="caption-form" class="p-5 sm:p-6">
        <div class="mb-5 flex items-start justify-between gap-3"><div><p class="mb-1 text-xs font-semibold tracking-widest text-muted" data-t="captionEditor">ক্যাপশন এডিটর</p><h2 id="dialog-title" class="font-display text-xl font-semibold" data-t="newCaption">নতুন ক্যাপশন</h2></div><button type="button" data-close-dialog class="grid size-9 place-items-center rounded-md text-muted hover:bg-surface-muted" aria-label="Close"><svg class="icon size-4"><use href="#icon-close" /></svg></button></div>
        <input id="caption-id" type="hidden" />
        <div class="space-y-4">
          <label class="block text-sm font-medium"><span data-t="captionText">ক্যাপশন</span><textarea id="caption-text" required maxlength="500" rows="5" class="mt-1.5 w-full resize-y rounded-md border border-border bg-canvas px-3 py-2 text-sm leading-6 outline-none focus:border-brand"></textarea><span class="mt-1 block text-xs text-muted"><span id="char-count">0</span>/500</span><span class="field-error hidden text-xs text-accent" data-error="text"></span></label>
          <div class="grid gap-4 sm:grid-cols-2"><label class="block text-sm font-medium"><span data-t="category">বিষয়</span><input id="caption-category" list="category-options" required maxlength="40" class="mt-1.5 h-10 w-full rounded-md border border-border bg-canvas px-3 text-sm outline-none focus:border-brand" /><datalist id="category-options"></datalist><span class="field-error hidden text-xs text-accent" data-error="category"></span></label><label class="block text-sm font-medium"><span data-t="author">লেখকের নাম</span><input id="caption-author" maxlength="80" class="mt-1.5 h-10 w-full rounded-md border border-border bg-canvas px-3 text-sm outline-none focus:border-brand" /><span class="field-error hidden text-xs text-accent" data-error="author"></span></label></div>
          <div class="flex flex-wrap gap-x-6 gap-y-3 rounded-md border border-border bg-canvas p-3"><label class="flex items-center gap-2 text-sm"><input id="caption-published" type="checkbox" class="size-4 accent-brand" checked /><span data-t="published">প্রকাশিত</span></label><label class="flex items-center gap-2 text-sm"><input id="caption-featured" type="checkbox" class="size-4 accent-brand" /><span data-t="featured">বিশেষ</span></label></div>
